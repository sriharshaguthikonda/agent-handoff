{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "python C:/AI/agent-handoff/claude/pretool_ask.py"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "python C:/AI/agent-handoff/scripts/notify.py"
          }
        ]
      }
    ]
  }
}
