# Notification fan-out targets — comma separated
# Valid: ntfy, telegram, burnttoast, slack
NOTIFY_TARGETS=ntfy,telegram,burnttoast,slack

# ntfy.sh — pick a long random topic, treat URL as secret
NTFY_URL=https://ntfy.sh/REPLACE-ME-LONG-RANDOM-TOPIC

# Telegram bot — reuse rescue plan bot per AGENT_PROTOCOL.md
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Slack incoming webhook
SLACK_WEBHOOK_URL=

# Windows toast via BurntToast — 1 to enable, 0 to skip
BURNTTOAST_ENABLED=1

# Twilio SMS — last-resort escalation only, leave blank to disable
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_TO=

# Watcher poll interval (seconds)
HANDOFF_POLL_INTERVAL=5

# Max age for an answer before treated as stale (seconds)
HANDOFF_ANSWER_TTL=86400
